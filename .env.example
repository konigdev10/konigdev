# ---------------------------------------------------------------------------
# Copier ce fichier en .env.local puis renseigner les valeurs.
# Aucune valeur réelle dans ce fichier : il est versionné.
# Les variables sans préfixe NEXT_PUBLIC_ ne doivent JAMAIS atteindre le
# navigateur ; elles ne sont lues que côté serveur (voir lib/supabase/admin.ts
# et lib/security/*, tous marqués import "server-only").
# ---------------------------------------------------------------------------

# --- Supabase -------------------------------------------------------------
# URL du projet et clé anonyme (publiques, protégées par les policies RLS).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé service role : serveur uniquement, contourne la RLS. Ne jamais exposer.
SUPABASE_SERVICE_ROLE_KEY=

# --- Identité de l'administrateur ----------------------------------------
# UUID du compte admin (Auth > Users > Identifiant). Comparé par le middleware,
# les actions serveur et les policies RLS. Un email ne suffit jamais.
ADMIN_USER_ID=

# --- Secrets serveur ------------------------------------------------------
# Sel du hash SHA-256 des adresses IP. 32 caractères minimum, aléatoires.
# Changer cette valeur rend obsolètes tous les ip_hash déjà enregistrés.
IP_HASH_SALT=
# Signature du cookie d'activité (déconnexion après inactivité). 32 caractères
# minimum. Sans elle, le client pourrait falsifier son horodatage d'activité.
SESSION_SIGNING_SECRET=
# Secret appelé en en-tête Authorization par la tâche planifiée de purge.
CRON_SECRET=

# --- n8n (relais du formulaire de contact et alertes de sécurité) ---------
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=

# --- Contact public -------------------------------------------------------
CONTACT_EMAIL=
NEXT_PUBLIC_WHATSAPP_NUMBER=

# --- Cloudflare Turnstile (facultatif) ------------------------------------
# Si TURNSTILE_SECRET_KEY est défini, le widget s'affiche sur /admin/login et
# sur le formulaire de contact. Les deux variables vont par paire.
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
